let bgMusicAudio = null; // Declare once for global access

function playBgMusic() {
    playSfx('sfxButton');
    if (!bgMusicAudio) {
        bgMusicAudio = document.getElementById('bgMusic');
        if (bgMusicAudio) {
            bgMusicAudio.volume = 0.15; // Set a lower background volume
        } else {
            showNotification("🎵 Background audio file not found. Ensure path is correct.");
            return;
        }
    }

    if (bgMusicAudio.paused) {
        bgMusicAudio.play().then(() => {
            showNotification("🎵 Ambient Network Soundscape Initiated...");
        }).catch(e => {
            console.warn("Autoplay was prevented:", e);
            showNotification("🎵 Tap anywhere to allow ambient soundscape. Browser policy.");
        });
    } else {
        bgMusicAudio.pause();
        showNotification("🔇 Ambient Network Soundscape Deactivated.");
    }
}


