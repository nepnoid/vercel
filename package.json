        const totalVirtueScore = Object.values(virtueScores).reduce((a, b) => a + b, 0) / 4;
        let endingMessage = '';
        let finalGncGain = finalGncReward;

        if (totalVirtueScore >= 80 && stressLevel < 50) {
            endingMessage = "🏛️ EXCELLENT PERFORMANCE! Your Stoic protocols yielded optimal results. Virtue amplified.";
            finalGncGain += 50; // Bonus GNC for high performance
        } else if (totalVirtueScore >= 70 && stressLevel < 70) {
            endingMessage = "⭐ SUCCESSFUL SIMULATION! You applied Stoic principles effectively. Further calibration recommended.";
            finalGncGain += 25; // Small bonus
        } else {
            endingMessage = "💪 SIMULATION COMPLETE. Areas for improvement detected. Every challenge is a data point for growth. Re-engage?";
        }

        updateGNCBalance(finalGncGain); // Add final scenario reward + any bonus
        addMessage(`SIMULATION REPORT: ${endingMessage}`, 'npc');

        // Show restart option
        const endControls = document.getElementById('endScenarioControls');
        endControls.innerHTML = `
            <div class="feedback-message">${endingMessage}</div>
            <div style="text-align: center;">
                <button class="btn btn-start" onclick="restartPractice()">
                    🎭 Re-Engage Protocol (New Scenario)
                </button>
                <button class="btn btn-reflect" onclick="showReflection()">
                    🪞 Analyze Data Log (Reflect)
                </button>
            </div>
        `;
        setTimeout(() => {
            endControls.classList.add('show');
            document.getElementById('conversationFeed').scrollTop = document.getElementById('conversationFeed').scrollHeight; // Scroll to bottom to show buttons
        }, 1000);

    }, 1000);
}


