// Utility function for playing sounds
function playSfx(id) {
    const sfx = document.getElementById(id);
    if (sfx) {
        sfx.currentTime = 0; // Reset to start for quick replays
        sfx.play().catch(e => console.warn("Audio play failed:", e)); // Add catch for autoplay policy
    }
}

// Interactive functions
function selectScenario(scenarioId) {
    playSfx('sfxButton'); // Play sound on button click

    document.querySelectorAll('.scenario-card').forEach(card => {
        card.classList.remove('selected');
    });
    const selectedCard = document.querySelector(`[data-scenario="${scenarioId}"]`);
    if (selectedCard) {
        selectedCard.classList.add('selected');
    }

    setTimeout(() => {
        startScenario(scenarioId);
    }, 600); // Slightly longer delay for animation
}

function startRandomScenario() {
    playSfx('sfxButton'); // Play sound on button click
    const scenarioIds = Object.keys(scenarios);
    const randomId = scenarioIds[Math.floor(Math.random() * scenarioIds.length)];
    selectScenario(randomId);
}

function startScenario(scenarioId) {
    currentScenario = scenarios[scenarioId];
    currentDialogueStep = currentScenario.dialogue.find(step => step.id === 'start'); // Find the initial dialogue step
    stressLevel = 75; // Reset stress for new scenario

    // Hide scenario selector and show conversation
    document.getElementById('scenarioSelector').classList.remove('active');
    document.getElementById('conversationArea').classList.add('active');
    document.getElementById('endScenarioControls').classList.remove('show'); // Hide end controls

    // Set up character
    document.getElementById('characterAvatar').textContent = currentScenario.character.avatar;
    document.getElementById('characterName').textContent = currentScenario.character.name;
    document.getElementById('characterMood').textContent = currentScenario.character.mood;
    document.getElementById('stressFill').style.width = `${stressLevel}%`;
    updateStressLevelDisplay(); // Update display immediately
    document.getElementById('characterAvatar').style.background = `linear-gradient(45deg, ${currentScenario.character.stressColor}, ${adjustColor(currentScenario.character.stressColor, -30)})`;
    document.getElementById('characterAvatar').style.boxShadow = `0 0 15px ${currentScenario.character.stressColor}`;


    // Clear conversation feed
    document.getElementById('conversationFeed').innerHTML = '';

    // Show live coaching
    document.getElementById('liveCoaching').classList.add('show');
    updateCoaching("Accessing Stoic Protocol: Their emotional output is external. Your internal state is your sole domain. Focus on your control parameters.");

    // Start conversation with typing indicator
    showTypingIndicator();
    setTimeout(() => {
        addMessage(currentDialogueStep.message, 'npc');
        showResponseOptions();
    }, 2000);

    showNotification("🏛️ Simulation Protocol Initiated! Apply Stoic Logic.");
    // Optionally play background music when scenario starts
    // playBgMusic();
}

function showTypingIndicator() {
    const feed = document.getElementById('conversationFeed');
    const typingDiv = document.createElement('div');
    typingDiv.className = 'message message-npc';
    typingDiv.id = 'typingIndicator';

    const characterAvatar = document.getElementById('characterAvatar');
    if (characterAvatar) {
        characterAvatar.classList.add('typing-avatar-active');
    }

    typingDiv.innerHTML = `
        <div class="message-avatar npc-avatar">${currentScenario.character.avatar}</div>
        <div class="typing-indicator">
            <span>${currentScenario.character.name} is processing...</span>
            <div class="typing-dots">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        </div>
    `;
    feed.appendChild(typingDiv);
    feed.scrollTop = feed.scrollHeight;
}

function removeTypingIndicator() {
    const indicator = document.getElementById('typingIndicator');
    if (indicator) {
        indicator.remove();
    }
    const characterAvatar = document.getElementById('characterAvatar');
    if (characterAvatar) {
        characterAvatar.classList.remove('typing-avatar-active');
    }
}

function addMessage(text, sender, analysis = null) {
    removeTypingIndicator();
    playSfx('sfxMessage'); // Play sound when message appears

    const feed = document.getElementById('conversationFeed');
    const messageDiv = document.createElement('div');
    messageDiv.className = `message message-${sender}`;

    const avatarChar = sender === 'npc' ? currentScenario.character.avatar : 'YOU'; // Player avatar text

    const avatar = `<div class="message-avatar ${sender}-avatar">${avatarChar}</div>`;

    const analysisHtml = analysis ? `<div class="stoic-analysis">🏛️ ${analysis}</div>` : '';

    messageDiv.innerHTML = `
        ${avatar}
        <div class="message-content">
            ${text}
            <div class="message-timestamp">${new Date().toLocaleTimeString()}</div>
            ${analysisHtml}
        </div>
    `;

    feed.appendChild(messageDiv);
    feed.scrollTop = feed.scrollHeight;
}

function showResponseOptions() {
    const optionsContainer = document.getElementById('responseOptions');
    optionsContainer.innerHTML = '';

    if (!currentDialogueStep || !currentDialogueStep.options) {
        console.error("No options for current dialogue step:", currentDialogueStep);
        endConversation();
        return;
    }

    currentDialogueStep.options.forEach((option, index) => {
        const optionDiv = document.createElement('div');
        optionDiv.className = `response-option ${option.type}`;
        optionDiv.onclick = () => selectResponse(option, optionDiv); // Pass optionDiv to add 'selected' class

        const virtueIcons = Object.entries(option.virtue).map(([virtue, change]) =>
            `<div class="virtue-meter ${change > 0 ? 'positive' : 'negative'}"></div>`
        ).join('');

        optionDiv.innerHTML = `
            <div class="response-text">${option.text}</div>
            <div class="response-meta">
                <div class="response-type type-${option.type}">
                    ${option.type.charAt(0).toUpperCase() + option.type.slice(1)}
                </div>
                <div class="virtue-impact">
                    ${virtueIcons}
                </div>
            </div>
        `;
        optionsContainer.appendChild(optionDiv);
    });
}

function selectResponse(chosenOption, chosenOptionDiv) {
    playSfx('sfxButton');

    // Add 'selected-player' class to the chosen option
    chosenOptionDiv.classList.add('selected-player');

    // Temporarily disable other options
    document.querySelectorAll('.response-option').forEach(option => {
        option.onclick = null; // Remove click listener
        if (option !== chosenOptionDiv) {
            option.style.opacity = '0.5'; // Dim other options
            option.style.pointerEvents = 'none'; // Make them unclickable
        }
    });


    // Add player message
    addMessage(chosenOption.text, 'player', getStoicAnalysis(chosenOption));

    // Update virtue scores
    updateVirtueScores(chosenOption.virtue);

    // Update GNC balance
    updateGNCBalance(chosenOption.gncImpact || 0); // Use 0 if gncImpact is not defined

    // Update stress level based on response
    updateStressLevel(chosenOption.type);

    // Update coaching
    updateCoaching(getCoachingAdvice(chosenOption));

    // Clear response options temporarily
    // We'll clear them after the NPC responds, for better flow
    // document.getElementById('responseOptions').innerHTML = '';


    // Determine next NPC message based on 'nextDialogueId'
    const nextNpcDialogue = currentScenario.dialogue.find(step => step.id === chosenOption.nextDialogueId);

    setTimeout(() => {
        if (nextNpcDialogue) {
            currentDialogueStep = nextNpcDialogue; // Update current step
            showTypingIndicator(); // Show typing indicator before NPC message
            setTimeout(() => {
                document.getElementById('responseOptions').innerHTML = ''; // Clear options only after NPC starts typing
                addMessage(currentDialogueStep.message, 'npc');
                if (currentDialogueStep.isEnd) {
                    endConversation(currentDialogueStep.gncReward); // Pass scenario-specific reward to end function
                } else {
                    setTimeout(showResponseOptions, 1000); // Otherwise, show next options
                }
            }, 2000); // Delay for NPC typing
        } else {
            console.error("Next dialogue step not found or undefined:", chosenOption.nextDialogueId);
            endConversation(currentScenario.dialogue.find(step => step.id === 'start').gncReward); // Fallback to scenario's base reward
        }
    }, 1000); // Small delay before NPC starts processing
}

function getStoicAnalysis(option) {
    const analyses = {
        stoic: [
            "Excellent! You demonstrated the **Virtue of Wisdom (Sophos)** by maintaining internal control and focusing on what is within your power.",
            "Marcus Aurelius would approve: you processed the external event with **Temperance (Sophrosyne)** rather than emotional reactivity.",
            "Optimal application of Stoic principles – acknowledging their human fallibility while safeguarding your **Justice (Dikaiosyne)** and **Courage (Andreia)**."
        ],
        impulsive: [
            "Warning: This response originated from emotional data, not virtue. A Stoic would initiate a **Cognitive Reset Protocol** first.",
            "This reaction redirects focus to personal validation rather than universal understanding. Re-evaluate your **Virtue of Justice**.",
            "Epictetus would prompt: 'It's not the external event, but your internal processing of it that generates distress.' Re-assess your **Wisdom**."
        ],
        diplomatic: [
            "Balanced input: You demonstrated **practical wisdom** by seeking common ground while upholding core principles.",
            "Effective mediation without compromising your internal **Virtue of Justice**. Commendable.",
            "Seneca would acknowledge this measured response as seeking mutual benefit while maintaining your **Temperance**."
        ]
    };

    const typeAnalyses = analyses[option.type];
    return typeAnalyses[Math.floor(Math.random() * typeAnalyses.length)];
}

function updateVirtueScores(changes) {
    let anyChange = false;
    Object.entries(changes).forEach(([virtue, change]) => {
        virtueScores[virtue] = Math.max(0, Math.min(100, virtueScores[virtue] + change));
        const bar = document.getElementById(`${virtue}Bar`);
        const score = document.getElementById(`${virtue}Score`);

        if (bar && score) {
            bar.style.width = `${virtueScores[virtue]}%`;
            score.textContent = `${virtueScores[virtue]}%`;
            anyChange = true;
        }
    });

    if (anyChange) {
        const changedVirtues = Object.entries(changes).map(([virtue, change]) =>
            `${virtue.charAt(0).toUpperCase() + virtue.slice(1)} ${change > 0 ? '+' : ''}${change}`
        ).join(', ');
        showNotification(`📈 Virtue Metric Update: ${changedVirtues}`);
    }
}

function updateGNCBalance(amount) {
    gncBalance += amount;
    const gncBalanceElement = document.getElementById('gncBalance');
    if (gncBalanceElement) {
        gncBalanceElement.textContent = `${gncBalance} GNC`;
    }
    if (amount > 0) {
        showNotification(`💎 GNC Acquisition: +${amount}!`);
        playSfx('sfxReward'); // Play reward sound
    } else if (amount < 0) {
        showNotification(`📉 GNC Deduction: ${amount}.`);
    }
}


function updateStressLevel(responseType) {
    const stressChanges = {
        stoic: -15,
        diplomatic: -10,
        impulsive: +20
    };

    stressLevel = Math.max(0, Math.min(100, stressLevel + stressChanges[responseType]));
    document.getElementById('stressFill').style.width = `${stressLevel}%`;
    updateStressLevelDisplay(); // Update text display
}

function updateStressLevelDisplay() {
    const stressLevelElement = document.getElementById('stressLevel');
    if (stressLevelElement) {
        let label = '';
        if (stressLevel >= 80) label = 'CRITICAL';
        else if (stressLevel >= 60) label = 'HIGH';
        else if (stressLevel >= 40) label = 'MODERATE';
        else if (stressLevel >= 20) label = 'LOW';
        else label = 'STABLE';
        stressLevelElement.textContent = label;

        // Change color based on stress level
        if (stressLevel >= 80) stressLevelElement.style.color = '#ef4444'; // Red
        else if (stressLevel >= 60) stressLevelElement.style.color = '#fbbf24'; // Yellow
        else stressLevelElement.style.color = '#39ff14'; // Green
    }
}

